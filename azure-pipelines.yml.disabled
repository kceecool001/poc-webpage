trigger:
  branches:
    include: [main]

pool:
  vmImage: ubuntu-24.04

variables:
   imageName: poc-web
   imageTag: $(Build.BuildId)  

stages:
  - stage: StaticAnalysis
    displayName: Static analysis
    jobs:
      - job: Lint
        steps:
          - script: |
              test -f index.html
              grep -q "<h1>" index.html
            displayName: Validate page
          - script: npx --yes htmlhint index.html
            displayName: HTMLHint
          - script: docker run --rm -i hadolint/hadolint:v2.12.0 hadolint --failure-threshold warning - < Dockerfile
            displayName: Hadolint

  - stage: Build
    displayName: Build image
    dependsOn: StaticAnalysis
    jobs:
      - job: BuildImage
        steps:
          - script: docker build -t $(imageName):$(imageTag) .
            displayName: Build image
          - script: |
              docker run -d -p 8080:80 --name poc $(imageName):$(imageTag)
              sleep 3
              curl -f http://localhost:8080 | grep "POC"
            displayName: Smoke test
          - script: docker save $(imageName):$(imageTag) -o $(Build.ArtifactStagingDirectory)/$(imageName).tar
            displayName: Export image
          - publish: $(Build.ArtifactStagingDirectory)/$(imageName).tar
            artifact: image
            displayName: Publish image artifact

  - stage: Scan
    displayName: Scan image
    dependsOn: Build
    jobs:
      - job: Trivy
        steps:
          - download: current
            artifact: image
          - script: |
              docker run --rm -v "$(Pipeline.Workspace)/image:/image" aquasec/trivy:0.57.1 \
                image --input /image/$(imageName).tar \
                --severity HIGH,CRITICAL --ignore-unfixed --exit-code 1
            displayName: Trivy scan (fail on HIGH/CRITICAL)

  - stage: Push
    displayName: Push to registry
    dependsOn: Scan
    condition: and(succeeded(), eq(variables['Build.SourceBranch'], 'refs/heads/main'))
    jobs:
      - job: PushImage
        steps:
          - download: current
            artifact: image
          - script: docker load -i $(Pipeline.Workspace)/image/$(imageName).tar
            displayName: Load image
          - task: Docker@2
            displayName: Login
            inputs:
              command: login
              containerRegistry: dockerhub-connection
          - script: |
              docker tag $(imageName):$(imageTag) <your-dockerhub-user>/$(imageName):$(imageTag)
              docker push <your-dockerhub-user>/$(imageName):$(imageTag)
            displayName: Tag and push



